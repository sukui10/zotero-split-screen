{
  "manifest_version": 2,
  "name": "Zotero 论文分屏",
  "version": "0.5.7",
  "description": "在 Zotero 主窗口的对比工作台中并排阅读、切换和对照多篇 PDF 文献。",
  "author": "Zotero Split Screen contributors",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "zotero-split-screen@local",
      "update_url": "https://example.invalid/zotero-split-screen/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "9.0.*"
    }
  }
}
